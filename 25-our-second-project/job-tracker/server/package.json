        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "better-sqlite3": "^13.2.0",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1"
    }
}
